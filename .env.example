# 1. Google Gemini API Key for Camino AI Guide (Optional - offline fallback is built-in)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Remote Cloud Database (supabase.com)
VITE_SUPABASE_URL=https://dxamjklrbeulpgdkxsha.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Ob0ACaYB-nnV-k-CWWcIuQ_2ZZ_OMKV

# 3. Azure AI Speech Pronunciation Assessment (SERVER-SIDE SECRETS ONLY)
# IMPORTANT: Never prefix with VITE_ or expose to browser code!
# Set these in your Supabase Edge Function secrets or local .env:
#   supabase secrets set AZURE_SPEECH_KEY=your_key AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# 4. Optional Custom Assessment Endpoint Override
# Defaults to: ${VITE_SUPABASE_URL}/functions/v1/assess-pronunciation, or /api/assess-pronunciation
# VITE_AZURE_ASSESSMENT_URL=https://your-custom-backend.example.com/api/assess-pronunciation
