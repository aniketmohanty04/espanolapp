# ========================================================
# ¡Aventura Española! Environment Configuration Template
# ========================================================

# 1. Google Gemini API Key for Camino AI Guide (SERVER-SIDE SECRET)
# IMPORTANT: Set GEMINI_API_KEY on Vercel / hosting environment secrets so it remains 100% private
# and is NEVER exposed or bundled into the client browser.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Azure AI Speech Pronunciation Assessment (SERVER-SIDE SECRETS ONLY)
# IMPORTANT: Never prefix with VITE_ or expose to browser code!
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# 3. Admin Authentication & Session Secrets (SERVER-SIDE SECRETS ONLY)
ADMIN_SECRET_KEY=your_strong_admin_secret_password_here
ADMIN_JWT_SECRET=your_long_random_hmac_sha256_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. Supabase Remote Cloud Database (Public frontend keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 5. Admin Route Access Key (Optional secret key required to access /admin entrance)
VITE_ADMIN_ACCESS_KEY=your_secret_access_token_here
